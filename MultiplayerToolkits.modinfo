<?xml version="1.0" encoding="utf-8"?>
<Mod id="a7026192-7310-4733-a297-9f90564b6466" version="202">
	<Properties>
		<Name>LOC_CCB2_NAME</Name>
		<Description>LOC_CCB2_DESCRIPTION</Description>
		<Teaser>LOC_CCB2_TEASER</Teaser>
		<Authors>LOC_CCB2_AUTHORS</Authors>
		<SpecialThanks></SpecialThanks>
		<AffectsSavedGames>0</AffectsSavedGames>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
		<CCBDisplayVersion>2.0.2-dev</CCBDisplayVersion>
	</Properties>

	<LocalizedText>
		<Text id="LOC_CCB2_NAME">
			<en_US>[COLOR_LIGHTBLUE]CCB Toolkit 2.0[ENDCOLOR]</en_US>
			<zh_Hans_CN>[COLOR_LIGHTBLUE]CCB 工具箱 2.0[ENDCOLOR]</zh_Hans_CN>
		</Text>
		<Text id="LOC_CCB2_DESCRIPTION">
			<en_US>CCB PVP toolkit 2.0. Includes configurable multiplayer UI helpers, CCB defaults, diplomacy options, map-pin controls, hotkeys, blacklist management and report-screen enhancements.</en_US>
			<zh_Hans_CN>CCB PVP 工具箱 2.0。包含可配置的多人 UI 辅助、CCB 默认设置、外交选项、地图钉控制、快捷键、黑名单管理和报告屏增强。</zh_Hans_CN>
		</Text>
		<Text id="LOC_CCB2_TEASER">
			<en_US>[Size_20]CCB PVP toolkit with practical multiplayer UI enhancements</en_US>
			<zh_Hans_CN>[Size_20]面向 CCB PVP 的多人游戏工具箱，提供实用 UI 增强</zh_Hans_CN>
		</Text>
		<Text id="LOC_CCB2_AUTHORS">
			<en_US>[COLOR:ResGoldLabelCS]@Bilibili我叫煎包[ENDCOLOR]</en_US>
			<zh_Hans_CN>[COLOR:ResGoldLabelCS]@Bilibili我叫煎包[ENDCOLOR]</zh_Hans_CN>
		</Text>
	</LocalizedText>

	<ActionCriteria>
		<!--Better City States (BCS)-->
		<Criteria id="SETTINGS_UI_CityStates" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BCS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<Criteria id="SETTINGS_UI_CityStates_BSM_1" any="0">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BCS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ModInUse>c6e5ad32-0600-4a98-a7cd-5854a1abcaaf</ModInUse>	<!--	Better Spectator Mod v1.2.6	-->
		</Criteria>
		
		<Criteria id="SETTINGS_UI_CityStates_BSM_2" any="0">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
			<ModInUse>c6e5ad32-0600-4a98-a7cd-5854a1abcaaf</ModInUse>	<!--	Better Spectator Mod v1.2.6	-->
		</Criteria>

		<!--Better Great People Popup (BGP)-->
		<Criteria id="SETTINGS_UI_GreatPeoplePopup" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BGP</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- Better Report Screen (BRS)-->
		<Criteria id="SETTINGS_UI_BetterReportScreen" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_BRS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!-- Notification Panel Quick Clear (NQC)-->
		<Criteria id="SETTINGS_UI_NotificationPanel_QuickClear" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_NQC</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!--Tech Civic Progress Boost Ratio Fix (TCP)-->
		<Criteria id="SETTINGS_UI_TechCivicProgressPro" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_TCP</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!--Top Panel Extension Pro (TPE)-->
		<Criteria id="SETTINGS_UI_TopPanelExtension" any="1">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI_TPE</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SETTINGS_UI</ConfigurationId>
				<Value>SETTINGS_UI_ENABLE_ALL</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<!--=====================================================================
			CCB 2.0 适配：以下 criteria 全部来自旧 CCB（v2.0-baseline）TeamPVPTools.modinfo，
			ID 与旧版保持一致，方便上游更新后重新应用。
			=====================================================================-->
		<!--外交限制（DDV）：默认全部关闭，玩家在高级设置里按需勾选-->
		<Criteria id="Diplomatic_MP_Off">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_MAKE_PEACE</ConfigurationId>
				<Value>NO_MAKE_PEACE</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<Criteria id="Diplomatic_MP_ON">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_MAKE_PEACE</ConfigurationId>
				<Value>CAN_MAKE_PEACE</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<Criteria id="Diplomatic_FS_Off">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_FRIENDSHIP</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<Criteria id="Diplomatic_delegation_Off">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>TPT_NO_DELEGATION</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<!--禁用地图钉（RMP）-->
		<Criteria id="No_Map_Pins">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>CPL_NO_PINS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<!--更多快捷键（NHK）-->
		<Criteria id="TPT_NEW_HOTKEYS">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>NEW_HOTKEYS</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>

		<!--地图钉快捷键：DetailedMapTacks 已在用它自己的 ActionId，装了 DMT 就让位-->
		<Criteria id="Disable_DMT">
			<ModInUse inverse="1">4ecfcc62-5471-4435-b295-590df213e8d8</ModInUse>	<!--	DetailedMapTacks	-->
		</Criteria>
	</ActionCriteria>

	<FrontEndActions>
		<!-- CCB MOD Check: shared Shell bootstrap and our native FE contexts. -->
		<UpdateDatabase id="CCBMC_SharedGameCore">
			<Properties><LoadOrder>11</LoadOrder></Properties>
